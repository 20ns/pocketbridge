  "components": [
    {
      "name": "Filled confirmation",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Native filled confirmation at its explicit minimum height.",
      "html": "<button class=\"ds-primary\">Send answer</button>",
      "css": ".ds-primary{font-family: sans-serif; font-size: 14px; line-height: 20px; font-weight: 500;min-height:48px;padding:8px 24px;border:0;border-radius:999px;background:#006A60;color:#FFFFFF;cursor:pointer;}.ds-primary:hover{background:linear-gradient(#FFFFFF14,#FFFFFF14),#006A60;}.ds-primary:active{background:linear-gradient(#FFFFFF1A,#FFFFFF1A),#006A60;}.ds-primary:focus-visible,.ds-tonal:focus-visible,.ds-text:focus-visible,.ds-field:focus-visible,.ds-back:focus-visible,.ds-step summary:focus-visible{outline:2px solid #006A60;outline-offset:2px;}"
    },
    {
      "name": "Tonal reconnect",
      "kind": "button",
      "refersTo": "button-tonal",
      "description": "Secondary reconnect action.",
      "html": "<button class=\"ds-tonal\">Reconnect</button>",
      "css": ".ds-tonal{font-family: sans-serif; font-size: 14px; line-height: 20px; font-weight: 500;min-height:48px;padding:8px 24px;border:0;border-radius:999px;background:#D3E9E3;color:#0B201C;cursor:pointer;}.ds-tonal:hover{background:linear-gradient(#0B201C14,#0B201C14),#D3E9E3;}.ds-tonal:active{background:linear-gradient(#0B201C1A,#0B201C1A),#D3E9E3;}.ds-primary:focus-visible,.ds-tonal:focus-visible,.ds-text:focus-visible,.ds-field:focus-visible,.ds-back:focus-visible,.ds-step summary:focus-visible{outline:2px solid #006A60;outline-offset:2px;}"
    },
    {
      "name": "Text action",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Secondary decision or retry.",
      "html": "<button class=\"ds-text\">Decline</button>",
      "css": ".ds-text{font-family: sans-serif; font-size: 14px; line-height: 20px; font-weight: 500;min-height:48px;padding:8px 12px;border:0;border-radius:999px;background:transparent;color:#006A60;cursor:pointer;}.ds-text:hover{background:#006A6014;}.ds-text:active{background:#006A601A;}.ds-primary:focus-visible,.ds-tonal:focus-visible,.ds-text:focus-visible,.ds-field:focus-visible,.ds-back:focus-visible,.ds-step summary:focus-visible{outline:2px solid #006A60;outline-offset:2px;}"
    },
    {
      "name": "Composer field",
      "kind": "input",
      "refersTo": "composer-field",
      "description": "Rounded filled message input, without an underline.",
      "html": "<textarea class=\"ds-field\" rows=\"1\" aria-label=\"Message Claude\" placeholder=\"Message Claude\"></textarea>",
      "css": ".ds-field{font:16px/24px sans-serif;letter-spacing:.5px;min-height:52px;padding:14px 16px;border:0;border-radius:26px;background:#E3E3DE;color:#1B1C1A;resize:vertical;caret-color:#006A60;}.ds-field::placeholder{color:#474B47;}.ds-field:hover{background:#E3E3DE;}.ds-primary:focus-visible,.ds-tonal:focus-visible,.ds-text:focus-visible,.ds-field:focus-visible,.ds-back:focus-visible,.ds-step summary:focus-visible{outline:2px solid #006A60;outline-offset:2px;}"
    },
    {
      "name": "Conversation header",
      "kind": "nav",
      "refersTo": "button-text",
      "description": "Named Back destination beside chat and project context.",
      "html": "<nav class=\"ds-nav\"><button class=\"ds-back\" aria-label=\"Back to recent chats\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 12H4m0 0 7-7m-7 7 7 7\"/></svg>Recent chats</button><div class=\"ds-heading\">Update the launcher<small>PocketBridge</small></div></nav>",
      "css": ".ds-nav{display:flex;gap:12px;align-items:center;padding:8px;background:#FAF9F5;color:#1B1C1A;font-family:sans-serif;}.ds-back{display:flex;align-items:center;gap:6px;min-height:48px;padding:8px 12px;border:0;border-radius:999px;background:transparent;color:#006A60;font:500 14px/20px sans-serif;cursor:pointer;}.ds-back svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2;}.ds-back:hover{background:#006A6014;}.ds-back:active{background:#006A601A;}.ds-heading{font-size:22px;line-height:28px;}.ds-heading small{display:block;font-size:12px;line-height:16px;color:#474B47;}.ds-primary:focus-visible,.ds-tonal:focus-visible,.ds-text:focus-visible,.ds-field:focus-visible,.ds-back:focus-visible,.ds-step summary:focus-visible{outline:2px solid #006A60;outline-offset:2px;}"
    },
    {
      "name": "User message",
      "kind": "custom",
      "refersTo": "user-bubble",
      "description": "Right-aligned selectable user message with a reduced sender corner.",
      "html": "<div class=\"ds-user-row\"><div class=\"ds-user\">Make the launcher start at login.</div></div>",
      "css": ".ds-user-row{display:flex;justify-content:flex-end;padding-left:48px;}.ds-user{padding:10px 16px;border-radius:20px 20px 6px 20px;background:#006A60;color:#FFFFFF;font:16px/24px sans-serif;letter-spacing:.5px;white-space:pre-wrap;}.ds-user::selection{background:#FFFFFF59;color:#FFFFFF;}"
    },
    {
      "name": "Claude reply",
      "kind": "custom",
      "refersTo": "assistant-bubble",
      "description": "Neutral reply with readable Markdown spacing.",
      "html": "<div class=\"ds-reply-row\"><div class=\"ds-reply\">The launcher now starts at login.<pre class=\"ds-code\">launchctl list</pre></div></div>",
      "css": ".ds-reply-row{display:flex;padding-right:24px;}.ds-reply{padding:12px 16px;border-radius:20px 20px 20px 6px;background:#E9E8E3;color:#1B1C1A;font:16px/24px sans-serif;letter-spacing:.5px;}.ds-code{margin:10px 0 0;padding:14px;border-radius:12px;background:#FFFFFF;font:12px/18px monospace;overflow:auto;}"
    },
    {
      "name": "Question card",
      "kind": "card",
      "refersTo": "question-card",
      "description": "A pending answer uses a restrained amber border.",
      "html": "<section class=\"ds-question\"><h2>Claude has a question</h2><label class=\"ds-option\"><input type=\"radio\" name=\"ds-question\"/>Start at login</label><label class=\"ds-option\"><input type=\"radio\" name=\"ds-question\"/>Open manually</label></section>",
      "css": ".ds-question{padding:16px;border:1px solid #8A5100;border-radius:18px;background:#F4F3EE;color:#1B1C1A;font-family:sans-serif;}.ds-question h2{margin:0 0 12px;font:500 16px/24px sans-serif;letter-spacing:.2px;}.ds-option{display:flex;align-items:center;gap:12px;min-height:48px;border-radius:12px;font:16px/24px sans-serif;cursor:pointer;}.ds-option input{accent-color:#006A60;margin:12px;}.ds-option:hover{background:#1B1C1A14;}.ds-option:focus-within{outline:2px solid #006A60;outline-offset:2px;}"
    },
    {
      "name": "Steps disclosure",
      "kind": "custom",
      "refersTo": "button-text",
      "description": "Tool activity stays collapsed until requested.",
      "html": "<details class=\"ds-step\"><summary>3 steps</summary><div>Read launcher settings</div></details>",
      "css": ".ds-step{font-family:sans-serif;color:#474B47;}.ds-step summary{min-height:48px;padding:6px 8px;border-radius:12px;font:500 14px/20px sans-serif;cursor:pointer;}.ds-step summary:hover{background:#1B1C1A14;}.ds-step summary:active{background:#1B1C1A14;}.ds-step div{margin-left:32px;padding:8px;font:14px/20px sans-serif;}.ds-primary:focus-visible,.ds-tonal:focus-visible,.ds-text:focus-visible,.ds-field:focus-visible,.ds-back:focus-visible,.ds-step summary:focus-visible{outline:2px solid #006A60;outline-offset:2px;}"
    }
  ],
  "narrative": {
    "northStar": "Native conversation log",
    "overview": "PocketBridge follows a familiar messaging layout on Android. Projects and recent chats use native lists. Right-aligned user bubbles, left-aligned replies and a fixed composer keep the conversation readable while Claude works on the Mac.\n\nThe phone follows system light or dark appearance and font scaling. Warm light backgrounds and charcoal dark backgrounds carry most of the interface. Teal identifies user messages and primary actions. Amber marks a question or decision; red marks errors and Stop. The Mac keeps its existing two-column conversation layout and platform font stack.",
    "keyCharacteristics": [
      "Platform typography and Material 3 controls on Android.",
      "Tonal separation for messages, code and the composer.",
      "Expandable steps and questions stay inside the conversation.",
      "Separate visual signals for Mac connection and chat activity."
    ],
    "rules": [
      {
        "name": "The Sender Rule",
        "body": "On Android, teal bubbles identify the user. Claude replies use neutral bubbles. Primary actions and links also use teal.",
        "section": "colors"
      },
      {
        "name": "The Native Scale Rule",
        "body": "Use the existing Material typography roles and keep Android text in sp so device font scaling applies.",
        "section": "typography"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Conversation content uses flat tonal layers. Preserve native Material elevation for floating actions and menus.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse Theme.kt roles and the Material typography inherited by PocketTheme.",
      "Do keep connection status separate from the state of Claude's task.",
      "Do keep the composer outside the scrolling transcript and respect keyboard and navigation insets.",
      "Do preserve selectable replies, copyable code, labelled controls and native question selection.",
      "Do keep Mac project registration and phone pairing controls in the Mac client."
    ],
    "donts": [
      "Don't add Android role labels, a logo panel, dashboard cards or phone folder registration.",
      "Don't use color alone to communicate a failure, pending answer or connection problem.",
      "Don't replace native font scaling with fixed pixel text on Android.",
      "Don't hide the permission mode or treat an unconfirmed prompt as delivered."
    ]
  }
}
